# ===== Robinhood Chain =====
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
# Wallet AGENT khusus bot — jangan wallet utama, isi secukupnya
PRIVATE_KEY=

# ===== Uniswap chain 4663 (node tools/fetch_addresses.mjs) =====
SWAP_ROUTER02=
V2_ROUTER=

# ===== Telegram userbot (my.telegram.org) =====
TG_API_ID=
TG_API_HASH=
SESSION_NAME=hoodsniper

# ===== Control bot (@BotFather) =====
BOT_TOKEN=
# user id Telegram Kakak (cek via @userinfobot) — cuma id ini yang bisa kontrol
ADMIN_ID=

# ===== Seed source awal (dipakai kalau DB masih kosong; selanjutnya atur via bot) =====
SEED_GROUP_ID=-1002103131992
SEED_TOPIC_DEGEN=250551
SEED_TOPIC_MEMBER=395868

# ===== Agent LLM — opsional, buat agent mode =====
# Protokol: "anthropic" (default) atau "openai" (OpenAI-compatible:
# OpenAI, DeepSeek, GLM/Zhipu, Kimi, Qwen, OpenRouter, 9router, LM Studio)
LLM_PROTOCOL=anthropic
LLM_API_KEY=
# Base URL — kosongkan utk default provider. Contoh:
#   DeepSeek   : LLM_PROTOCOL=openai  LLM_BASE_URL=https://api.deepseek.com/v1        model: deepseek-chat
#   GLM/Zhipu  : LLM_PROTOCOL=openai  LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  model: glm-4.7
#   Kimi       : LLM_PROTOCOL=openai  LLM_BASE_URL=https://api.moonshot.ai/v1          model: kimi-k2
#   OpenRouter : LLM_PROTOCOL=openai  LLM_BASE_URL=https://openrouter.ai/api/v1        model: bebas
#   LM Studio  : LLM_PROTOCOL=openai  LLM_BASE_URL=http://localhost:1234/v1
LLM_BASE_URL=

# ===== Dexscreener =====
DEX_CHAIN_MATCH=robinhood
DB_PATH=hoodsniper.db
